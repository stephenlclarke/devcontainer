{
  "name": "devcontainer-parity-reuse",
  "image": "alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce",
  "overrideCommand": true,
  "remoteUser": "root",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/devcontainer-parity,type=bind",
  "workspaceFolder": "/workspaces/devcontainer-parity",
  "mounts": [
    "source=dcparity-d07-reuse,target=/cache,type=volume"
  ],
  "postCreateCommand": "value=$(cat /cache/create-count 2>/dev/null || printf 0); printf '%s\\n' \"$((value + 1))\" > /cache/create-count",
  "postStartCommand": "value=$(cat /cache/start-count 2>/dev/null || printf 0); printf '%s\\n' \"$((value + 1))\" > /cache/start-count"
}
