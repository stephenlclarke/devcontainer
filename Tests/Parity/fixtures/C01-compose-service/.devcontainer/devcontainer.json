{
  "name": "devcontainer-parity-compose",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "runServices": [
    "app"
  ],
  "shutdownAction": "stopCompose",
  "overrideCommand": true,
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/devcontainer-parity",
  "postCreateCommand": "printf 'compose-post-create\\n' > /tmp/devcontainer-compose-hook"
}
