{
  "name": "devcontainer-parity-image",
  "image": "alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce",
  "overrideCommand": true,
  "remoteUser": "root",
  "containerEnv": {
    "DEVCONTAINER_PARITY": "image-config"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/devcontainer-parity,type=bind",
  "workspaceFolder": "/workspaces/devcontainer-parity",
  "postCreateCommand": "printf 'post-create\\n' > /tmp/devcontainer-post-create"
}
