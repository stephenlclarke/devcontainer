sh_test(
    name = "released_engine_negotiation",
    srcs = ["released-engine.sh"],
    data = [":released_engine_inputs"],
    size = "medium",
    # E04's sequential setup/build/cleanup budgets exceed 900 seconds. Keep
    # all shorter phase deadlines and reserve outer time for owned teardown.
    timeout = "eternal",
    tags = ["manual", "local", "no-sandbox", "no-cache"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "released_docker_engine",
    srcs = ["released-engine.sh"],
    data = [":released_engine_inputs"],
    size = "large",
    # VM boot plus E03 and verified shutdown allow >900 seconds in total.
    # Individual commands/operations retain their much shorter deadlines.
    timeout = "eternal",
    tags = ["manual", "local", "no-sandbox", "no-cache"],
    visibility = ["//visibility:public"],
)
